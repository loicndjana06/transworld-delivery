rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(agency){return signedIn() && request.auth.token.admin == true && request.auth.token.agencyId == agency;}
  match /shipments/{id} {
   allow read: if admin(resource.data.agencyId) || (signedIn() && resource.data.clientUid == request.auth.uid);
   allow create: if admin(request.resource.data.agencyId);
   allow update: if admin(resource.data.agencyId) && request.resource.data.agencyId == resource.data.agencyId;
   allow delete: if false;
  }
  match /publicTracking/{ref} {
   allow get: if true;
   allow list: if false;
   allow create: if admin(request.resource.data.agencyId);
   allow update: if admin(resource.data.agencyId) && request.resource.data.agencyId == resource.data.agencyId;
   allow delete: if false;
  }
  match /{document=**} {allow read,write: if false;}
 }
}
